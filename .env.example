# Optional settings. Nothing here is required for the local demo.
# Require "Authorization: Bearer <token>" on management API writes.
FLAGSHIP_ADMIN_TOKEN=change-me
# Replace the demo SDK keys: {"<key>": ["<env>", "server" | "client"]}
FLAGSHIP_KEYS={"sdk-prod-replace-me": ["prod", "server"], "client-prod-replace-me": ["prod", "client"]}
FLAGSHIP_DB=data/flagship.db
# Seconds between scheduled change checks
FLAGSHIP_SCHEDULER_S=5
